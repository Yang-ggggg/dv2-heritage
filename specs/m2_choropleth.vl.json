{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Tasmania has the most old",
      "newspapers per resident"
    ],
    "subtitle": [
      "Digitised newspaper articles on Trove (all years,",
      "October 2026) divided by residents (March 2026)."
    ]
  },
  "width": 520,
  "height": 390,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ],
    "scale": 620.9,
    "translate": [
      183.6,
      -380.0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "transform": [
        {
          "lookup": "properties.state",
          "from": {
            "data": {
              "url": "data/trove_states.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "articles_2026": "number",
                  "population_mar2026": "number",
                  "articles_per_resident": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "articles_2026",
              "population_mar2026",
              "articles_per_resident"
            ]
          }
        },
        {
          "calculate": "datum.articles_per_resident < 5 ? 'Under 5' : datum.articles_per_resident < 10 ? '5 to 9.9' : datum.articles_per_resident < 20 ? '10 to 19.9' : '20 or more'",
          "as": "per_resident_class"
        }
      ],
      "params": [
        {
          "name": "hovered_state",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout",
            "fields": [
              "properties.state"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "per_resident_class",
          "type": "ordinal",
          "title": "Articles per resident",
          "scale": {
            "domain": [
              "Under 5",
              "5 to 9.9",
              "10 to 19.9",
              "20 or more"
            ],
            "range": [
              "#bdd7e7",
              "#6baed6",
              "#3182bd",
              "#08519c"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Articles per resident",
            "titleOrient": "left",
            "symbolType": "square",
            "symbolSize": 150,
            "symbolStrokeWidth": 0,
            "offset": 28
          }
        },
        "strokeWidth": {
          "condition": {
            "param": "hovered_state",
            "empty": false,
            "value": 2.5
          },
          "value": 1
        },
        "stroke": {
          "condition": {
            "param": "hovered_state",
            "empty": false,
            "value": "#1E1E1A"
          },
          "value": "#FFFFFF"
        },
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "articles_per_resident",
            "type": "quantitative",
            "title": "Articles per resident",
            "format": ".1f"
          },
          {
            "field": "articles_2026",
            "type": "quantitative",
            "title": "Digitised articles",
            "format": ","
          },
          {
            "field": "population_mar2026",
            "type": "quantitative",
            "title": "Residents (March 2026)",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 149.1,
            "lat": -35.4,
            "lon2": 153.0,
            "lat2": -37.6
          }
        ]
      },
