{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Tasmania has the most old newspapers per resident",
    "subtitle": [
      "Digitised newspaper articles on Trove (all years, February 2025)",
      "divided by residents (March 2026)."
    ],
    "anchor": "start"
  },
  "width": 500,
  "height": 400,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "data": {
    "url": "data/australia_states.topojson",
    "format": {
      "type": "topojson",
      "feature": "australia_states"
    }
  },
  "transform": [
    {
      "lookup": "properties.state",
      "from": {
        "data": {
          "url": "data/trove_states.csv",
          "format": {
            "type": "csv",
            "parse": {
              "articles_2025": "number",
              "population_mar2026": "number",
              "articles_per_resident": "number"
            }
          }
        },
        "key": "state",
        "fields": [
          "articles_2025",
          "population_mar2026",
          "articles_per_resident"
        ]
      }
    }
  ],
  "params": [
    {
      "name": "hovered_state",
      "select": {
        "type": "point",
        "on": "pointerover",
        "clear": "pointerout",
        "fields": [
          "properties.state"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#FFFFFF",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "articles_per_resident",
      "type": "quantitative",
      "title": "Articles per resident",
      "scale": {
        "type": "threshold",
        "domain": [
          5,
          10,
          20
        ],
        "range": [
          "#bdd7e7",
          "#6baed6",
          "#3182bd",
          "#08519c"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "title": "Articles per resident",
        "titleOrient": "left",
        "labelExpr": "datum.label"
      }
    },
    "strokeWidth": {
      "condition": {
        "param": "hovered_state",
        "empty": false,
        "value": 2.5
      },
      "value": 1
    },
    "stroke": {
      "condition": {
        "param": "hovered_state",
        "empty": false,
        "value": "#1E1E1A"
      },
      "value": "#FFFFFF"
    },
    "tooltip": [
      {
        "field": "properties.state",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "articles_per_resident",
        "type": "quantitative",
        "title": "Articles per resident",
        "format": ".1f"
      },
      {
        "field": "articles_2025",
        "type": "quantitative",
        "title": "Digitised articles",
        "format": ","
      },
      {
        "field": "population_mar2026",
        "type": "quantitative",
        "title": "Residents (Mar 2026)",
        "format": ","
      }
    ]
  },
  "config": {
    "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
    "title": {
      "font": "'Libre Caslon Text', Georgia, serif",
      "fontSize": 18,
      "subtitleFontSize": 13,
      "subtitleColor": "#55554D"
    },
    "view": {
      "stroke": null
    }
  }
}