{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Older collections are far more",
      "likely to be online"
    ],
    "subtitle": [
      "Share of items digitised, by the decade a collection",
      "begins (March 2023). Dot area = items in that decade."
    ]
  },
  "width": 640,
  "height": 363,
  "data": {
    "url": "data/manuscripts_by_decade.csv",
    "format": {
      "type": "csv",
      "parse": {
        "decade": "number",
        "collections": "number",
        "items": "number",
        "digitised_items": "number",
        "share_digitised": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.collections >= 20"
    }
  ],
  "encoding": {
    "x": {
      "field": "decade",
      "type": "quantitative",
      "scale": {
        "domain": [
          1750,
          2010
        ],
        "nice": false
      },
      "axis": {
        "title": "Decade the collection begins",
        "values": [
          1760,
          1800,
          1840,
          1880,
          1920,
          1960,
          2000
        ],
        "labelExpr": "datum.value + 's'",
        "grid": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#3182bd",
        "strokeWidth": 2.5
      },
      "encoding": {
        "y": {
          "field": "share_digitised",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": "Items digitised",
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "labelExpr": "datum.value + '%'"
          }
        },
        "y2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#3182bd",
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "share_digitised",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "decade",
            "title": "Decade begins",
            "format": "d"
          },
          {
            "field": "collections",
            "title": "Collections",
            "format": ","
          },
          {
            "field": "items",
            "title": "Items",
            "format": ","
          },
          {
            "field": "digitised_items",
            "title": "Items digitised",
            "format": ","
          },
          {
            "field": "share_digitised",
            "title": "Share digitised (per cent)",
            "format": ".1f"
          }
        ],
        "size": {
          "field": "items",
          "type": "quantitative",
          "title": "Dot size",
          "scale": {
            "domain": [
              0,
              40000
            ],
            "range": [
              0,
              500
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "values": [
              1000,
              10000,
              30000
            ],
            "titleOrient": "left",
            "labelExpr": "format(datum.value, ',') + ' items'"
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "decade": 1858,
            "share": 92,
            "text": "1760s to 1820s: 64% to 99% online,"
          },
          {
            "decade": 1858,
            "share": 86,
            "text": "but only 59,417 items in total"
          },
          {
            "decade": 1912,
            "share": 42,
            "text": "1930s to 1980s: 1% to 5.5% online,"
          },
          {
            "decade": 1912,
            "share": 36,
            "text": "out of 158,970 items in total"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 14,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "quantitative"
        },
        "y": {
          "field": "share",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ]
}