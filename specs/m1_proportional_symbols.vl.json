{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "New South Wales grew nine times since 2011",
    "subtitle": [
      "Digitised newspaper articles on Trove by state or territory.",
      "Outline circle = April 2011. Filled circle = February 2025."
    ]
  },
  "width": 400,
  "height": 400,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E6E6E0",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/trove_states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "articles_2011": "number",
            "articles_2025": "number",
            "growth_times": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "-datum.articles_2025",
          "as": "draw_order"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "articles_2025",
          "type": "quantitative",
          "title": "Articles",
          "scale": {
            "domain": [
              0,
              90000000
            ],
            "range": [
              0,
              3600
            ]
          },
          "legend": {
            "orient": "bottom",
            "values": [
              5000000,
              25000000,
              90000000
            ],
            "labelExpr": "format(datum.value/1e6,'.0f') + ' million'",
            "symbolFillColor": "#3182bd",
            "symbolStrokeColor": "#FFFFFF",
            "direction": "horizontal",
            "titleOrient": "left"
          }
        },
        "color": {
          "value": "#3182bd"
        },
        "order": {
          "field": "draw_order",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State or territory"
          },
          {
            "field": "articles_2011",
            "title": "April 2011",
            "format": ","
          },
          {
            "field": "articles_2025",
            "title": "February 2025",
            "format": ","
          },
          {
            "field": "growth_times",
            "title": "Times bigger",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/trove_states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "articles_2011": "number",
            "articles_2025": "number",
            "growth_times": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "filled": false,
        "stroke": "#1E1E1A",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "articles_2011",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State or territory"
          },
          {
            "field": "articles_2011",
            "title": "April 2011",
            "format": ","
          },
          {
            "field": "articles_2025",
            "title": "February 2025",
            "format": ","
          },
          {
            "field": "growth_times",
            "title": "Times bigger",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 151.9,
            "lat": -31.0,
            "t1": "New South Wales",
            "t2": "9.2 times bigger"
          },
          {
            "lon": 133.4,
            "lat": -17.6,
            "t1": "Northern Territory",
            "t2": "no growth (1.0 times)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 12,
        "fontWeight": 700,
        "dy": -7
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t1"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 151.9,
            "lat": -31.0,
            "t1": "New South Wales",
            "t2": "9.2 times bigger"
          },
          {
            "lon": 133.4,
            "lat": -17.6,
            "t1": "Northern Territory",
            "t2": "no growth (1.0 times)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 12,
        "dy": 8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t2"
        }
      }
    }
  ]
}