{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "New South Wales has the most",
      "digitised newspapers"
    ],
    "subtitle": [
      "Digitised newspaper articles on Trove by state or",
      "territory (October 2026). Circle area = articles."
    ]
  },
  "width": 400,
  "height": 400,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E6E6E0",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/trove_states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "articles_2011": "number",
            "articles_2026": "number",
            "growth_times": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "-datum.articles_2026",
          "as": "draw_order"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "articles_2026",
          "type": "quantitative",
          "title": "Articles",
          "scale": {
            "domain": [
              0,
              90000000
            ],
            "range": [
              0,
              3600
            ]
          },
          "legend": {
            "orient": "bottom",
            "values": [
              1000000,
              10000000,
              50000000
            ],
            "labelExpr": "format(datum.value/1e6,'.0f') + ' million'",
            "symbolFillColor": "#3182bd",
            "symbolStrokeColor": "#FFFFFF",
            "direction": "horizontal",
            "titleOrient": "left"
          }
        },
        "color": {
          "value": "#3182bd"
        },
        "order": {
          "field": "draw_order",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State or territory"
          },
          {
            "field": "articles_2026",
            "title": "Articles (October 2026)",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 151.9,
            "lat": -31.0,
            "t1": "New South Wales",
            "t2": "90.0 million articles"
          },
          {
            "lon": 133.4,
            "lat": -17.6,
            "t1": "Northern Territory",
            "t2": "0.5 million, the fewest"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 14,
        "fontWeight": 700,
        "dy": -7
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t1"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 151.9,
            "lat": -31.0,
            "t1": "New South Wales",
            "t2": "90.0 million articles"
          },
          {
            "lon": 133.4,
            "lat": -17.6,
            "t1": "Northern Territory",
            "t2": "0.5 million, the fewest"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 14,
        "dy": 8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t2"
        }
      }
    }
  ]
}
