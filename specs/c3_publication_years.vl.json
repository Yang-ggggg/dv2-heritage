{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australia's online newspapers drop sharply at 1955",
    "subtitle": [
      "Articles on Trove by year of publication, October 2026.",
      "Each bar is one year."
    ]
  },
  "width": 1000,
  "height": 320,
  "data": {
    "url": "data/trove_by_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "articles_2026": "number",
        "articles_2011": "number"
      }
    }
  },
  "params": [
    {
      "name": "show_2011",
      "value": false,
      "bind": {
        "input": "checkbox",
        "name": "Compare with April 2011 (grey outline) "
      }
    }
  ],
  "transform": [
    {
      "calculate": "datum.year + 1",
      "as": "year_end"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "scale": {
        "domain": [
          1800,
          2026
        ],
        "nice": false
      },
      "axis": {
        "format": "d",
        "title": "Year the article was published",
        "tickCount": 12,
        "grid": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#3182bd",
        "binSpacing": 0
      },
      "encoding": {
        "x2": {
          "field": "year_end"
        },
        "y": {
          "field": "articles_2026",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              5200000
            ]
          },
          "axis": {
            "title": "Articles",
            "labelExpr": "datum.value == 0 ? '0' : format(datum.value / 1000000, '.0f') + ' million'",
            "tickCount": 5
          }
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "articles_2026",
            "title": "Articles (October 2026)",
            "format": ","
          },
          {
            "field": "articles_2011",
            "title": "Articles (April 2011)",
            "format": ","
          }
        ],
        "y2": {
          "datum": 0
        }
      }
    },
    {
      "transform": [
        {
          "filter": "show_2011"
        },
        {
          "filter": "isValid(datum.articles_2011)"
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "step-after",
        "color": "#6E6E66",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "articles_2011",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1913,
            "y": 4900000,
            "text": "1915: 4.9 million articles, the peak year"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -2,
        "baseline": "middle",
        "fontSize": 14,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1956,
            "y": 3661437,
            "text": "1954: 3.82 million articles"
          },
          {
            "x": 1956,
            "y": 3261437,
            "text": "1955: only 0.79 million (79% fewer)"
          },
          {
            "x": 1956,
            "y": 2711437,
            "text": "Copyright: Trove mostly includes papers"
          },
          {
            "x": 1956,
            "y": 2361437,
            "text": "published before 1956."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "baseline": "middle",
        "fontSize": 14,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      },
      "transform": [
        {
          "filter": "datum.y > 3000000"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "x": 1956,
            "y": 3661437,
            "text": "1954: 3.82 million articles"
          },
          {
            "x": 1956,
            "y": 3261437,
            "text": "1955: only 0.79 million (79% fewer)"
          },
          {
            "x": 1956,
            "y": 2711437,
            "text": "Copyright: Trove mostly includes papers"
          },
          {
            "x": 1956,
            "y": 2361437,
            "text": "published before 1956."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "baseline": "middle",
        "fontSize": 14,
        "fontWeight": 400
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      },
      "transform": [
        {
          "filter": "datum.y <= 3000000"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "x": 1955,
            "y": 0,
            "y2": 3900000
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#1E1E1A",
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "y2": {
          "field": "y2"
        }
      }
    }
  ]
}