{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Only 9 in 100 oral history",
      "recordings have a transcript"
    ],
    "subtitle": [
      "Oral history recordings listed on Trove (December 2023).",
      "Each microphone is about 200 recordings."
    ]
  },
  "width": 440,
  "height": 470,
  "data": {
    "url": "data/oral_history_icons.csv",
    "format": {
      "type": "csv",
      "parse": {
        "row": "number",
        "column": "number",
        "recordings_in_group": "number",
        "share_percent": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.column + (datum.column >= 5 ? 0.6 : 0)",
      "as": "x_position"
    },
    {
      "calculate": "datum.row + (datum.row >= 5 ? 0.5 : 0)",
      "as": "y_position"
    }
  ],
  "mark": {
    "type": "point",
    "shape": "M-0.28,-0.72 A0.28,0.28 0 0 1 0.28,-0.72 L0.28,-0.12 A0.28,0.28 0 0 1 -0.28,-0.12 Z M-0.5,-0.15 L-0.4,-0.15 A0.4,0.4 0 0 0 0.4,-0.15 L0.5,-0.15 A0.5,0.5 0 0 1 -0.5,-0.15 Z M-0.06,0.33 L0.06,0.33 L0.06,0.75 L-0.06,0.75 Z M-0.35,0.75 L0.35,0.75 L0.35,0.9 L-0.35,0.9 Z",
    "filled": true,
    "size": 950,
    "opacity": 1,
    "strokeWidth": 0
  },
  "encoding": {
    "x": {
      "field": "x_position",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          -0.5,
          10.1
        ],
        "nice": false
      }
    },
    "y": {
      "field": "y_position",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          -0.5,
          10.0
        ],
        "nice": false,
        "reverse": true
      }
    },
    "color": {
      "field": "status",
      "type": "ordinal",
      "title": null,
      "scale": {
        "domain": [
          "Online with a transcript",
          "Listen online, no transcript",
          "Not online"
        ],
        "range": [
          "#08519c",
          "#4292c6",
          "#9ecae1"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "vertical",
        "symbolType": "square",
        "symbolSize": 150,
        "labelLimit": 400,
        "labelExpr": "datum.label == 'Online with a transcript' ? 'Online with a transcript: 1,781 (8.9%)' : datum.label == 'Listen online, no transcript' ? 'Listen online, no transcript: 4,421 (22.0%)' : 'Not online: 13,881 (69.1%)'"
      }
    },
    "tooltip": [
      {
        "field": "status",
        "type": "nominal",
        "title": "Status"
      },
      {
        "field": "recordings_in_group",
        "type": "quantitative",
        "title": "Recordings",
        "format": ","
      },
      {
        "field": "share_percent",
        "type": "quantitative",
        "title": "Share (per cent)",
        "format": ".1f"
      }
    ]
  }
}
