{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "title": {
    "text": [
      "More than half of digitised files",
      "are Second World War service records"
    ],
    "subtitle": [
      "National Archives of Australia files digitised from March 2021",
      "to September 2026, by theme. Each box is one record series;",
      "its area is the number of files. Small series are grouped."
    ],
    "anchor": "start"
  },
  "width": 680,
  "height": 430,
  "padding": {
    "left": 0,
    "top": 5,
    "right": 5,
    "bottom": 5
  },
  "data": [
    {
      "name": "tree",
      "url": "data/naa_treemap.csv",
      "format": {
        "type": "csv",
        "parse": {
          "files": "number",
          "share_percent": "number",
          "theme_share_percent": "number"
        }
      },
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "files",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "round": true,
          "method": "squarify",
          "ratio": 1.4,
          "paddingInner": 1,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },
    {
      "name": "themes",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        }
      ]
    },
    {
      "name": "labelled_themes",
      "source": "themes",
      "transform": [
        {
          "type": "filter",
          "expr": "(datum.x1 - datum.x0) > 60 && (datum.y1 - datum.y0) > 38"
        }
      ]
    },
    {
      "name": "series",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        }
      ]
    },
    {
      "name": "quote_lines",
      "values": [
        {
          "line": 0,
          "text": "The National Archives says"
        },
        {
          "line": 1,
          "text": "access to these records is"
        },
        {
          "line": 2,
          "text": "\u201cone of the most popular"
        },
        {
          "line": 3,
          "text": "requests\u201d it receives."
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "theme_colour",
      "type": "ordinal",
      "domain": [
        "Second World War service records",
        "Migration and citizenship records",
        "Photographs",
        "Patents",
        "Other files"
      ],
      "range": [
        "#fd8d3c",
        "#9e9ac8",
        "#d9d9d9",
        "#d9d9d9",
        "#d9d9d9"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "series"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "theme_colour",
            "field": "theme"
          },
          "stroke": {
            "value": "#FFFFFF"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "{'Theme': datum.theme, 'Series': datum.name, 'Series number': datum.series === 'grouped' ? 'several' : datum.series, 'Files': format(datum.files, ','), 'Share of all files': format(datum.share_percent, '.1f') + '%'}"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 0.75
          }
        },
        "update": {
          "fillOpacity": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "themes"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "value": "#FFFFFF"
          },
          "strokeWidth": {
            "value": 4
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "labelled_themes"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.x0 + 8"
          },
          "y": {
            "signal": "datum.y0 + 19"
          },
          "text": {
            "field": "name"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 14"
          },
          "font": {
            "value": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif"
          },
          "fontSize": {
            "value": 14
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "value": "#1E1E1A"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "labelled_themes"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.x0 + 8"
          },
          "y": {
            "signal": "datum.y0 + 36"
          },
          "text": {
            "signal": "format(datum.theme_share_percent, '.1f') + ((datum.x1 - datum.x0) > 130 ? '% of files' : '%')"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 14"
          },
          "font": {
            "value": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#1E1E1A"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "quote_lines"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "x": {
            "value": 10
          },
          "y": {
            "signal": "76 + datum.line * 18"
          },
          "text": {
            "field": "text"
          },
          "font": {
            "value": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#1E1E1A"
          }
        }
      }
    }
  ]
}
