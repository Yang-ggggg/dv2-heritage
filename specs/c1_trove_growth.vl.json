{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Trove's newspapers grew 5.5 times since 2011",
    "subtitle": [
      "Total digitised newspaper articles on Trove, 2011 to 2026.",
      "Dots: single counts. Line: weekly harvests.",
      "Dashed: no harvests from February 2025 to October 2026."
    ]
  },
  "width": 610,
  "height": 300,
  "data": {
    "url": "data/trove_growth.csv",
    "format": {
      "type": "csv",
      "parse": {
        "harvest_date": "date",
        "total_articles": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "harvest_date",
      "type": "temporal",
      "title": null,
      "scale": {
        "domain": [
          "2010-06-01",
          "2027-06-01"
        ]
      },
      "axis": {
        "format": "%Y",
        "tickCount": 8,
        "grid": false
      }
    },
    "y": {
      "field": "total_articles",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          300000000
        ]
      },
      "axis": {
        "title": "Articles",
        "labelExpr": "datum.value == 0 ? '0' : format(datum.value / 1000000, '.0f') + ' million'",
        "tickCount": 7
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#3182bd",
        "strokeWidth": 2.5
      },
      "transform": [
        {
          "filter": "datum.harvest_type != 'api_refresh'"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "d": "2025-02-16",
            "v": 251022068
          },
          {
            "d": "2026-10-20",
            "v": 266321617
          }
        ]
      },
      "mark": {
        "type": "line",
        "color": "#3182bd",
        "strokeWidth": 2,
        "strokeDash": [
          4,
          4
        ]
      },
      "encoding": {
        "x": {
          "field": "d",
          "type": "temporal"
        },
        "y": {
          "field": "v",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.harvest_type != 'weekly'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#3182bd",
        "size": 55
      }
    },
    {
      "mark": {
        "type": "point",
        "opacity": 0,
        "size": 120
      },
      "encoding": {
        "tooltip": [
          {
            "field": "harvest_date",
            "type": "temporal",
            "title": "Harvest date",
            "format": "%d %B %Y"
          },
          {
            "field": "total_articles",
            "title": "Articles",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "d": "2011-04-12",
            "v": 48481646,
            "t": "48.5 million (April 2011)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": 16,
        "fontWeight": 700,
        "fontSize": 14
      },
      "encoding": {
        "x": {
          "field": "d",
          "type": "temporal"
        },
        "y": {
          "field": "v",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "d": "2026-10-20",
            "v": 266321617,
            "t": "266.3 million (October 2026)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": 6,
        "dy": -16,
        "fontWeight": 700,
        "fontSize": 14
      },
      "encoding": {
        "x": {
          "field": "d",
          "type": "temporal"
        },
        "y": {
          "field": "v",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "d": "2025-02-21",
            "v0": 0,
            "v1": 235000000
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#1E1E1A",
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "d",
          "type": "temporal"
        },
        "y": {
          "field": "v0",
          "type": "quantitative"
        },
        "y2": {
          "field": "v1"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "d": "2025-02-21",
            "v": 120000000,
            "t": "Harvest stopped:"
          },
          {
            "d": "2025-02-21",
            "v": 104000000,
            "t": "Trove cancelled data access keys"
          },
          {
            "d": "2025-02-21",
            "v": 88000000,
            "t": "on 21 February 2025"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -6,
        "fontSize": 14,
        "color": "#55554D"
      },
      "encoding": {
        "x": {
          "field": "d",
          "type": "temporal"
        },
        "y": {
          "field": "v",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ]
}